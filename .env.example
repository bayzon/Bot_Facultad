# Bot Facultad — Environment template
# Copy to .env and fill with real values. Never commit .env.

# --- RAG Core (required) — at least one provider must be set ---
OPENAI_API_KEY=sk-proj-REEMPLAZAR_CON_TU_KEY_REAL
# Gemini free-tier alternative (preferred if set). Get key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AQ....2A  # placeholder — replace with real key or leave empty to use OpenAI

# --- WhatsApp Cloud API (required for webhook/PR2) ---
VERIFY_TOKEN=tu_verify_token_seguro
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# App Secret for HMAC SHA256 verification of X-Hub-Signature-256 (horariumTest parity).
# Get from Meta App Dashboard > App Settings > Basic > App Secret. Required in prod to accept webhooks from Ramiro's number.
WHATSAPP_APP_SECRET=REEMPLAZAR_CON_APP_SECRET_DE_META
# Graph API version — horariumTest uses v23.0. Override via env if Meta bumps version.
WHATSAPP_GRAPH_VERSION=v23.0

# --- Optional alternative LLM provider ---
# Groq API key (optional) — if set, rag_core can use Groq/Llama as fallback.
# Get at https://console.groq.com/keys
GROQ_API_KEY=gsk_REEMPLAZAR_CON_TU_KEY_REAL

# --- Google Drive Service Account (required for drive/PR2) ---
# Path to Service Account JSON OR inline JSON string
GOOGLE_SERVICE_ACCOUNT_JSON=./bot-facultad-sa.json
# Drive folder ID for Bot_Facultad_Materias (share folder with SA as Editor)
GOOGLE_DRIVE_FOLDER_ID=1AbCxxxxxxxxxxxxxxxxxxxx
